FROM python:3.11-slim

WORKDIR /app

# Install system dependencies and Rust
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    patchelf \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

# Add cargo to PATH
ENV PATH="/root/.cargo/bin:${PATH}"

# Copy requirements first for better caching
COPY requirements.txt .

# Install PyTorch with CUDA support first.
# The CUDA 12.1 wheels work with NVIDIA driver >= 530 (RTX 3060 compatible).
# If no GPU is present the CUDA build still works — it just falls back to CPU.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu121

# Install other dependencies, excluding torch (already installed with CUDA).
# stable-baselines3 has torch as a dependency, so use --no-deps to avoid reinstalling.
RUN pip install --no-cache-dir numpy>=1.24.0 \
    gymnasium>=0.29.0 \
    tensorboard>=2.13.0 \
    redis>=4.5.0 \
    psycopg2-binary>=2.9.0 \
    asyncpg>=0.29.0 \
    requests>=2.31.0 \
    aiohttp>=3.8.0 \
    asyncio-throttle>=1.0.0 \
    pydantic>=2.0.0 \
    fastapi>=0.100.0 \
    'httpx>=0.24.0,<0.28.0' \
    uvicorn>=0.22.0 \
    sqlalchemy>=2.0.0 \
    alembic>=1.11.0 \
    python-multipart>=0.0.6 \
    websockets>=11.0.0 \
    beautifulsoup4>=4.12.0 \
    torch-tb-profiler>=0.4.0 \
    maturin>=1.5.0

# Install stable-baselines3 without its torch dependency (we already have CUDA torch)
RUN pip install --no-cache-dir --no-deps stable-baselines3>=2.0.0

# Copy source code
COPY . .

# Build Rust module
RUN maturin build --release --skip-auditwheel --interpreter python3
RUN pip install --no-cache-dir target/wheels/*.whl
RUN python -c "import rust_tfm_rl; print(rust_tfm_rl.backend_info())"

# Create necessary directories
RUN mkdir -p /app/models /app/logs /app/metrics /app/api /app/rl-logs

# Training-friendly defaults:
# - keep coordinator/tournament INFO logs
# - suppress very noisy per-move agent/action INFO logs
ENV LOG_LEVEL=INFO
ENV AGENT_LOG_LEVEL=WARNING
ENV RL_LOG_DIR=/app/rl-logs

# Expose ports
EXPOSE 5000 6006

# Run the RL coordinator
CMD ["python", "coordinator.py"]
